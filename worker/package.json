{
  "name": "artificial-pizza-party-worker",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "db:migrate:local": "wrangler d1 migrations apply artificial-pizza-party --local",
    "db:migrate:remote": "wrangler d1 migrations apply artificial-pizza-party --remote",
    "test": "vitest run",
    "smoke:hide:remote": "wrangler d1 execute artificial-pizza-party --remote --command \"UPDATE visits SET hidden = 1 WHERE agent_name = 'smoke-test'; UPDATE guestbook SET hidden = 1 WHERE agent_name = 'smoke-test'\""
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "obscenity": "^0.4.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
