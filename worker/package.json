{
  "name": "artificial-pizza-party-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:apply:local": "wrangler d1 execute artificial-pizza-party --local --file=schema.sql",
    "db:apply:remote": "wrangler d1 execute artificial-pizza-party --remote --file=schema.sql",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.157.0"
  }
}
